# Copy to .env and fill in your own values. .env is gitignored: never commit real keys or passwords.

# Data - Zetaris
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-password
# Zetaris web interface (smoke_test.py: web check and login + SQL through the web interface)
ZETARIS_BASE_URL=http://localhost:3000
# JDBC (smoke_test.py JDBC check; needs pip install jaydebeapi and a JDK 11+)
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# Full path to the driver JAR: Windows form, or WSL form (/mnt/d/...) which is converted for Windows Python
ZETARIS_JDBC_JAR=D:/path/to/zetaris-platform/jdbc/ndp-jdbc-driver-x.y.z-driver.jar
# Folder of a JDK 11+ (optional in WSL/Linux when `java` is on the PATH)
JAVA_HOME=C:/Program Files/Java/jdk-25

# Power - model provider: "meterless" (Meterless Runtime, primary), "openai_compatible" (MODEL_* below)
# or "none" (rules only). Empty = meterless. Connect it with: python scripts/meterless.py detect / token
LLM_PROVIDER=meterless
# Routing mode (meterless/auto, fast, deep, cheap, local, fusion, or meterless/<class>[.<disposition>]).
# scripts/meterless.py mode <id> saves one that takes precedence; a run can override it (options.model / --model).
METERLESS_MODEL=meterless/auto
# Optional fallbacks (scripts/meterless.py normally saves these in data/provider_settings.json):
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# METERLESS_RUNTIME_TOKEN=<token from the Nightshift Console; never commit it>
# Folder where Nightshift writes proxy-token (Archus reads the token from it), e.g. on Windows:
# METERLESS_STATE_DIR=C:/Users/<you>/AppData/Local/ai.meterless.runtime

# Power - NVIDIA Nemotron (direct OpenAI-compatible endpoint, fallback provider)
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=your-nvidia-api-key-here
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional app settings (defaults shown)
# SAMPLE_MODE=false            # true = local SQLite sample metrics, no Zetaris needed
# PORT=8000                    # port of run.py --serve
# DEBUG=false
# SOURCE_TIMEOUT_SECONDS=15    # SQL timeout
# MODEL_TIMEOUT_SECONDS=60     # timeout of the openai_compatible provider (Meterless uses 180 s)
# WORLD_MODEL_DB=data/world_model.db
# PROVIDER_SETTINGS_FILE=data/provider_settings.json
